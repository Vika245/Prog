a = int(input("Введите номер кармана: "))
if not 0 <= a <= 36:
    print("Ошибка ввода")
elif a == 0:
    print("Зеленый")
elif 1 <= a <= 10 or 19 <= a <= 28:
    if a % 2:
        print("Красный")
    else:
        print("Черный")
else:
    if a % 2:
        print("Черный")
    else:
        print("Красный")
